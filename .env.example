# Окружение: development | production.
# В production приложение громко предупреждает в логах, если секреты ниже
# остались значениями по умолчанию (см. docs/deployment.md).
ENVIRONMENT=development

# Разрешённые источники для CORS. В проде заменить на реальный домен панели:
# CORS_ORIGINS=["https://sd.example.com"]
CORS_ORIGINS=["*"]

# PostgreSQL
POSTGRES_USER=sd
POSTGRES_PASSWORD=sd
POSTGRES_DB=sd

# Внешний порт nginx (API)
HTTP_PORT=8080

# Внешний порт панели (SPA, собирается и отдаётся отдельным nginx-контейнером
# frontend — см. docker-compose.yml)
FRONTEND_PORT=8081
# Адрес API, который увидит браузер пользователя (обычно http://localhost:<HTTP_PORT>);
# вшивается в JS-бандл при сборке образа frontend, поменять — пересобрать контейнер
FRONTEND_API_BASE_URL=http://localhost:8080

# JWT — обязательно сменить в продуктиве
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Первый администратор (создаётся сидом, если пользователей нет)
SEED_ADMIN_EMAIL=admin@o-horizons.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Вложения
DEFAULT_TICKET_ATTACHMENT_LIMIT_MB=25

# SLA-движок (Этап 3)
SLA_WARNING_THRESHOLD=0.75
WORKER_INTERVAL_SECONDS=60

# Шифрование секретов интеграций (Этап 4) — небезопасный dev-ключ по умолчанию,
# сгенерировать свой перед вводом реальных учётных данных каналов:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SETTINGS_ENCRYPTION_KEY=jP7WgoQPzPJpZgjNEQ7irtTLLEYhHQfpKxKZSQhcvlk=
