# Окружение: development | production.
# В production приложение громко предупреждает в логах, если секреты ниже
# остались значениями по умолчанию (см. docs/deployment.md).
ENVIRONMENT=development

# Разрешённые источники для CORS. В проде заменить на реальный домен панели:
# CORS_ORIGINS=["https://sd.example.com"]
CORS_ORIGINS=["*"]

# PostgreSQL
POSTGRES_USER=sd
POSTGRES_PASSWORD=sd
POSTGRES_DB=sd

# Внешний порт nginx (API)
HTTP_PORT=8080

# Внешний порт панели (SPA, собирается и отдаётся отдельным nginx-контейнером
# frontend — см. docker-compose.yml)
FRONTEND_PORT=8081
# Адрес API в браузере: /api работает через прокси панели на том же домене;
# вшивается в JS-бандл при сборке образа frontend, поменять — пересобрать контейнер.
# За обратным прокси — /api: панель сама пропускает /api/ к API, и адрес
# годится и снаружи по https, и из локальной сети.
FRONTEND_API_BASE_URL=/api

# JWT — обязательно сменить в продуктиве
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Первый администратор (создаётся сидом, если пользователей нет)
SEED_ADMIN_EMAIL=admin@o-horizons.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Вложения
DEFAULT_TICKET_ATTACHMENT_LIMIT_MB=25

# SLA-движок (Этап 3)
SLA_WARNING_THRESHOLD=0.75
WORKER_INTERVAL_SECONDS=60

# Шифрование секретов интеграций (Этап 4) — небезопасный dev-ключ по умолчанию,
# сгенерировать свой перед вводом реальных учётных данных каналов:
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SETTINGS_ENCRYPTION_KEY=jP7WgoQPzPJpZgjNEQ7irtTLLEYhHQfpKxKZSQhcvlk=

# Канал «Периметр»: общий секрет служб продукта (облако «Периметр», издатель),
# которые передают переписку из окна «Поддержка». Пусто — канал выключен.
# Тот же секрет задаётся в облаке (PERIMETR_SD_SECRET) и издателе
# (PUBLISHER_SD_SECRET). Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
PERIMETR_SECRET=

# Надёжность каналов и контроль фоновой обработки
# Сырые успешно обработанные события очищаются, ключи защиты от дублей сохраняются.
CHANNEL_EVENT_RETENTION_DAYS=14
# Более крупные письма остаются непрочитанными в IMAP и видны как ошибка в журнале.
INBOUND_EMAIL_LIMIT_MB=48
MIN_FREE_ATTACHMENT_MB=100
